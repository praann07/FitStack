DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
JWT_SECRET=changeme

# Optional -- defaults shown are fine for local dev.
# CORS_ORIGINS=["http://localhost:5173"]
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax   # use "none" (with COOKIE_SECURE=true) once frontend and backend are on different HTTPS domains

# Only needed to run the test suite (pytest) -- point at a throwaway Postgres
# database, e.g. a second database on the same free Neon project. Never point
# this at your real dev/prod database; tests roll back their writes but still
# create the schema there.
# TEST_DATABASE_URL=postgresql+psycopg://user:password@host/fitstack_test?sslmode=require
